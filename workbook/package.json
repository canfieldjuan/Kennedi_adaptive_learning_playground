{
  "name": "kennedi-is-the-boss-workbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Printable workbook builder for Kennedi Is the Boss - Learning Book 1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "pdf": "node scripts/export-pdf.mjs",
    "screenshots": "node scripts/screenshot.mjs",
    "rasterize": "node scripts/rasterize-pdf.mjs",
    "verify": "node scripts/verify.mjs",
    "preview": "npm run build && node -e \"console.log('Preview built. Open dist/preview.html in your browser (double-click or: xdg-open dist/preview.html).')\"",
    "all": "npm run build && npm run pdf && npm run screenshots && npm run rasterize && npm run verify",
    "alphabet:build": "node scripts/alphabet.mjs build",
    "alphabet:pdf": "node scripts/alphabet.mjs pdf",
    "alphabet:screenshots": "node scripts/alphabet.mjs screenshots",
    "alphabet:rasterize": "node scripts/alphabet.mjs rasterize",
    "alphabet:verify": "node scripts/alphabet.mjs verify",
    "alphabet:all": "node scripts/alphabet.mjs all",
    "alphabet:test": "node --test tests/alphabet-practice.test.mjs",
    "numbers:build": "node scripts/numbers.mjs build",
    "numbers:pdf": "node scripts/numbers.mjs pdf",
    "numbers:screenshots": "node scripts/numbers.mjs screenshots",
    "numbers:rasterize": "node scripts/numbers.mjs rasterize",
    "numbers:verify": "node scripts/numbers.mjs verify",
    "numbers:all": "node scripts/numbers.mjs all",
    "counting:build": "node scripts/counting.mjs build",
    "counting:pdf": "node scripts/counting.mjs pdf",
    "counting:screenshots": "node scripts/counting.mjs screenshots",
    "counting:rasterize": "node scripts/counting.mjs rasterize",
    "counting:verify": "node scripts/counting.mjs verify",
    "counting:all": "node scripts/counting.mjs all",
    "counting:test": "node --test tests/counting-practice.test.mjs"
  },
  "devDependencies": {
    "fontkit": "^2.0.4",
    "playwright": "1.62.1"
  }
}
